10 PRINT "Prime factors"
20 PRINT
30 PRINT "Enter the number to factor, or 0 to quit"
40 PRINT "n";
50 INPUT N
60 IF N < 2 THEN 99999
70 PRINT N; "=";
80 IF N < 4 THEN 500
90 IF INT(N / 2) * 2 <> N THEN 130
100 PRINT "2*";
110 LET N = N / 2
120 GOTO 80
130 FOR P = 3 TO SQR(N) STEP 2
140 IF P * P > N THEN 500
150 IF INT(N / P) * P <> N THEN 190
160 PRINT P; "*";
170 LET N = N / P
180 GOTO 140
190 NEXT P
500 PRINT N
510 GOTO 20
99999 END
